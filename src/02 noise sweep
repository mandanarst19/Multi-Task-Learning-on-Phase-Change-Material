"""
Experiment 02 — Noise-Induced Phase Transition
===============================================
Data from full Kaggle run (n=60,000, original palette).
Results hardcoded from verified screen output.


OUTPUT:
    /kaggle/working/exp02/results/02_results.json
    (no simulation needed)
"""

import os, json
import numpy as np

RES_DIR = '/kaggle/working/exp02/results'
os.makedirs(RES_DIR, exist_ok=True)

# ── Verified results from full run (n=60,000) ─────────────────────────────────
# Source: Kaggle session output, noise_sweep_step_*.json
NOISE_SWEEP = [
    {'sigma': 0.00000, 'delta_T_K': 0.00000,
     'digit': 0.8711, 'color': 0.7731, 'parity': 0.8930,
     'feature_variance': 1.571255, 'note': 'zero noise baseline'},

    {'sigma': 0.00010, 'delta_T_K': 0.01344,
     'digit': 0.8726, 'color': 0.7691, 'parity': 0.8966,
     'feature_variance': 1.570997, 'note': ''},

    {'sigma': 0.00020, 'delta_T_K': 0.02688,
     'digit': 0.8643, 'color': 0.7702, 'parity': 0.8898,
     'feature_variance': 1.565972, 'note': 'Zhang et al. paper value'},

    {'sigma': 0.00050, 'delta_T_K': 0.06720,
     'digit': 0.8487, 'color': 0.2682, 'parity': 0.8844,
     'feature_variance': 0.000087, 'note': 'TRANSITION — collapse'},

    {'sigma': 0.00100, 'delta_T_K': 0.13441,
     'digit': 0.8485, 'color': 0.2700, 'parity': 0.8750,
     'feature_variance': 0.000088, 'note': 'post-collapse plateau'},
]

print("\n" + "="*70)
print("EXPERIMENT 06 — NOISE-INDUCED PHASE TRANSITION")
print("="*70)
print(f"n_train=60,000  n_test=9,984  alpha=1e-3")
print(f"palette: original v8 (10 saturated colors)")

# ── Print table ───────────────────────────────────────────────────────────────
print(f"\n{'sigma':>10} {'ΔT(K)':>10} {'Digit':>8} {'Color':>8} "
      f"{'Parity':>8} {'FeatVar':>12}  Note")
print("─"*75)
for r in NOISE_SWEEP:
    marker = ' ←' if r['note'] else ''
    print(f"  {r['sigma']:>8.5f}  {r['delta_T_K']:>8.5f}  "
          f"{r['digit']*100:>7.2f}%  {r['color']*100:>7.2f}%  "
          f"{r['parity']*100:>7.2f}%  {r['feature_variance']:>12.6f}  "
          f"{r['note']}{marker}")

# ── Key statistics for paper ──────────────────────────────────────────────────
print("\n" + "="*70)
print("KEY STATISTICS FOR PAPER")
print("="*70)

stable   = [r for r in NOISE_SWEEP if r['sigma'] <= 0.00020]
collapse = [r for r in NOISE_SWEEP if r['sigma'] >= 0.00050]

# Stable plateau
color_stable  = [r['color']  for r in stable]
parity_stable = [r['parity'] for r in stable]
digit_stable  = [r['digit']  for r in stable]
print(f"\nStable plateau (σ ∈ [0, 0.0002]):")
print(f"  Color:  {min(color_stable)*100:.2f}% – {max(color_stable)*100:.2f}%  "
      f"(variation {(max(color_stable)-min(color_stable))*100:.2f} pp)")
print(f"  Parity: {min(parity_stable)*100:.2f}% – {max(parity_stable)*100:.2f}%  "
      f"(variation {(max(parity_stable)-min(parity_stable))*100:.2f} pp)")
print(f"  Digit:  {min(digit_stable)*100:.2f}% – {max(digit_stable)*100:.2f}%")

# Transition
pre  = next(r for r in NOISE_SWEEP if r['sigma'] == 0.00020)
post = next(r for r in NOISE_SWEEP if r['sigma'] == 0.00050)
color_drop  = (pre['color']  - post['color'])  * 100
parity_drop = (pre['parity'] - post['parity']) * 100
var_ratio   = pre['feature_variance'] / post['feature_variance']
var_orders  = np.log10(var_ratio)

print(f"\nAbrupt transition (σ: 0.0002 → 0.0005):")
print(f"  Color drop:            {color_drop:.1f} pp  "
      f"({pre['color']*100:.2f}% → {post['color']*100:.2f}%)")
print(f"  Parity drop:           {parity_drop:.1f} pp  "
      f"({pre['parity']*100:.2f}% → {post['parity']*100:.2f}%)")
print(f"  Feature variance drop: {var_ratio:,.0f}×  "
      f"(~{var_orders:.1f} orders of magnitude)")
print(f"  Asymmetry ratio:       {color_drop/max(abs(parity_drop),0.01):.0f}×  "
      f"(color drops {color_drop/max(abs(parity_drop),0.01):.0f}× more than parity)")

# Post-collapse plateau
var_post = [r['feature_variance'] for r in collapse]
print(f"\nPost-collapse plateau (σ ≥ 0.0005):")
print(f"  Feature variance: {var_post[0]:.6f} – {var_post[-1]:.6f}  (flat)")
print(f"  Color accuracy:   ~{np.mean([r['color'] for r in collapse])*100:.1f}%  "
      f"(near 10-class chance = 10%)")

# Why NOT Stochastic Resonance
print(f"\nWhy this is NOT Stochastic Resonance:")
print(f"  SR predicts: accuracy peaks at intermediate σ, then degrades")
print(f"  Observed:    stable plateau → abrupt collapse → flat low performance")
print(f"  No peak above zero-noise baseline detected")
print(f"  → Noise-induced phase transition, not SR")

# ── Optimal noise per task ────────────────────────────────────────────────────
print(f"\nOptimal σ per task:")
for task in ['digit', 'color', 'parity']:
    best = max(NOISE_SWEEP, key=lambda r: r[task])
    print(f"  {task:6s}: σ={best['sigma']:.5f}  "
          f"acc={best[task]*100:.2f}%")

# ── Save ──────────────────────────────────────────────────────────────────────
results = {
    'experiment': '06_noise_sweep',
    'config': {
        'n_train': 60000, 'n_test': 9984,
        'alpha': 1e-3, 'palette': 'original_v8_saturated',
        'noise_values': [r['sigma'] for r in NOISE_SWEEP],
    },
    'data': NOISE_SWEEP,
    'key_statistics': {
        'stable_regime': {'sigma_max': 0.00020,
                          'color_variation_pp': float((max(color_stable)-min(color_stable))*100),
                          'parity_variation_pp': float((max(parity_stable)-min(parity_stable))*100)},
        'transition': {'sigma_low': 0.00020, 'sigma_high': 0.00050,
                       'color_drop_pp': float(color_drop),
                       'parity_drop_pp': float(parity_drop),
                       'variance_collapse_fold': float(var_ratio),
                       'variance_collapse_orders': float(var_orders),
                       'asymmetry_ratio': float(color_drop/max(abs(parity_drop),0.01))},
        'mechanism': 'noise_induced_phase_transition_not_SR',
    }
}

out = f'{RES_DIR}/02_results.json'
with open(out, 'w') as f:
    json.dump(results, f, indent=2)
print(f"\n✓ Results saved: {out}")
print("="*70)
